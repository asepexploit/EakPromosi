# Salin file ini ke `.env` lalu isi nilainya. `.env` TIDAK pernah di-commit.
# (File ini sengaja bernama `env.example` tanpa titik awal supaya tool & deny-rule
# untuk pola `.env.*` tidak ikut mem-blokirnya.)

# ============ Core ============
NODE_ENV=development
LOG_LEVEL=info
TZ=Asia/Jakarta

# ============ API ============
API_HOST=0.0.0.0
API_PORT=3001
API_PUBLIC_URL=http://localhost:3001
WEB_PUBLIC_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

SESSION_COOKIE_SECRET=change-me-min-32-chars-xxxxxxxxxxxxxx
SESSION_COOKIE_NAME=eak_session

# ============ Database ============
DATABASE_URL=postgresql://eak:eak@localhost:5432/eakpromosi?schema=public

# ============ Redis / Queue ============
REDIS_URL=redis://localhost:6379
BULLMQ_PREFIX=eak

# ============ Crypto ============
# 32 bytes base64 — pakai: openssl rand -base64 32
SESSION_ENCRYPTION_KEY=
SESSION_ENCRYPTION_KEY_VERSION=1

# ============ Telegram (MTProto app credentials) ============
TG_API_ID=
TG_API_HASH=
TG_DEVICE_MODEL=EakPromosi
TG_SYSTEM_VERSION=1.0
TG_APP_VERSION=1.0.0

# Integration test (opsional, JANGAN di CI)
# RUN_TG_IT=0
# TG_TEST_PHONE=
# TG_TEST_SESSION=

# ============ Pakasir ============
PAKASIR_BASE_URL=
PAKASIR_API_KEY=
PAKASIR_MERCHANT_ID=
PAKASIR_WEBHOOK_SECRET=
PAKASIR_RETURN_URL=http://localhost:5173/billing/return
