# Salin file ini ke `.env` lalu isi nilainya. `.env` TIDAK pernah di-commit.
# (File ini sengaja bernama `env.example` tanpa titik awal supaya tool & deny-rule
# untuk pola `.env.*` tidak ikut mem-blokirnya.)
#
# Nama variabel di sini WAJIB cocok dengan `packages/config/src/env.ts` —
# loader memvalidasi via Zod dan menolak boot kalau ada yang kurang / salah.

# ============ Core ============
NODE_ENV=development
LOG_LEVEL=info
PRETTY_LOG=false
TZ=Asia/Jakarta

# ============ API ============
API_HOST=0.0.0.0
API_PORT=4000
# Harus mengarah ke origin SPA (digunakan untuk Pakasir callbackUrl/redirectUrl).
PUBLIC_WEB_ORIGIN=http://localhost:5173
# CSV. Setiap origin HARUS termasuk scheme + host (+ port). Jangan tambah slash di akhir.
CORS_ORIGINS=http://localhost:5173
SESSION_COOKIE_NAME=eak_session
# Min 32 chars — rahasia untuk @fastify/cookie signing.
SESSION_SECRET=change-me-min-32-chars-xxxxxxxxxxxxxx
# Min 32 chars — rahasia HMAC untuk double-submit CSRF token.
CSRF_SECRET=change-me-min-32-chars-xxxxxxxxxxxxxx
# Nyalakan jika API ada di belakang reverse proxy yang set X-Forwarded-For (nginx, Cloudflare).
# Rate-limit per-IP dan audit log IP butuh ini akurat.
TRUST_PROXY=false

# ============ Database ============
DATABASE_URL=postgresql://eak:eak@localhost:5432/eakpromosi?schema=public

# ============ Redis / Queue ============
REDIS_URL=redis://localhost:6379
BULLMQ_PREFIX=eak

# ============ Crypto (MTProto session at-rest) ============
# 32 bytes base64 — pakai: openssl rand -base64 32
SESSION_ENCRYPTION_KEY=
SESSION_ENCRYPTION_KEY_VERSION=1

# ============ Telegram (MTProto app credentials) ============
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Opsional — hanya kalau pakai Bot API (Telegraf) di samping MTProto.
TELEGRAM_BOT_TOKEN=

# Integration test (opsional, JANGAN di CI)
# RUN_TG_IT=0
# TG_TEST_PHONE=
# TG_TEST_SESSION=

# ============ Pakasir ============
PAKASIR_BASE_URL=
PAKASIR_API_KEY=
PAKASIR_PROJECT=
# Min 16 chars — rahasia HMAC webhook (bytes-sensitive, jangan transform).
PAKASIR_WEBHOOK_SECRET=

# ============ Platform admin bootstrap (opsional) ============
# Dipakai sekali oleh seed/CLI untuk membuat super-admin pertama.
# ADMIN_BOOTSTRAP_EMAIL=
# ADMIN_BOOTSTRAP_PASSWORD=

# ============ Web (apps/web) ============
# Salin ke apps/web/.env.local. Web hanya bicara ke API — tidak pernah ke Telegram / Pakasir langsung.
VITE_API_BASE_URL=http://localhost:4000
# true = pakai mock in-memory di browser (sebelum apps/api siap).
VITE_USE_MOCKS=true
