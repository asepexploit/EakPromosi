{
  "name": "@eak/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./seed": "./seed/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "tsx seed/index.ts",
    "studio": "prisma studio",
    "test": "vitest run --passWithNoTests"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx seed/index.ts"
  },
  "dependencies": {
    "@prisma/client": "5.21.1"
  },
  "devDependencies": {
    "@eak/config": "workspace:*",
    "@eak/shared": "workspace:*",
    "@types/node": "20.17.1",
    "prisma": "5.21.1",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "2.1.4"
  }
}
