{
  "name": "@eak/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "cross-env RUN_INTEGRATION=1 vitest run"
  },
  "dependencies": {
    "@eak/config": "workspace:*",
    "@eak/db": "workspace:*",
    "@eak/shared": "workspace:*",
    "@fastify/cookie": "11.0.1",
    "@fastify/cors": "10.0.1",
    "@fastify/helmet": "12.0.1",
    "@fastify/rate-limit": "10.1.1",
    "@fastify/sensible": "6.0.1",
    "@fastify/websocket": "11.0.1",
    "argon2": "0.41.1",
    "bullmq": "5.21.2",
    "fastify": "5.12.7",
    "fastify-type-provider-zod": "4.0.2",
    "ioredis": "5.4.1",
    "pino": "9.5.0",
    "zod": "3.25.28"
  },
  "devDependencies": {
    "@types/node": "20.17.1",
    "@types/supertest": "6.0.2",
    "cross-env": "7.0.3",
    "supertest": "7.0.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "2.1.4"
  }
}
